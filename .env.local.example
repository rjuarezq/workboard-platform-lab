WORKBOARD_BACKEND_IMAGE=workboard-backend:local
WORKBOARD_FRONTEND_IMAGE=workboard-frontend:local

POSTGRES_IMAGE=postgres:18.6-alpine3.24

POSTGRES_DB=workboard
POSTGRES_PASSWORD=REPLACE-YOUR-PASSWORD

WORKBOARD_MIGRATOR_DB_PASSWORD=REPLACE-YOUR-PASSWORD
WORKBOARD_MIGRATION_DATABASE_URL=postgresql+psycopg://workboard_migrator:REPLACE-YOUR-PASSWORD@db:5432/workboard

WORKBOARD_APP_DB_PASSWORD=REPLACE-YOUR-PASSWORD
WORKBOARD_RUNTIME_DATABASE_URL=postgresql+psycopg://workboard_app:REPLACE-YOUR-PASSWORD@db:5432/workboard

WORKBOARD_JWT_SECRET=REPLACE-YOUR-JWT
