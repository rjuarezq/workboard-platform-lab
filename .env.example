POSTGRES_IMAGE=postgres:18.6-alpine3.24
WORKBOARD_BACKEND_IMAGE=workboard-backend:local
WORKBOARD_FRONTEND_IMAGE=workboard-frontend:local

POSTGRES_DB=workboard
POSTGRES_PASSWORD=replace_with_a_48_character_hex_secret
WORKBOARD_MIGRATOR_DB_PASSWORD=replace_with_a_different_48_character_hex_secret
WORKBOARD_APP_DB_PASSWORD=replace_with_a_different_48_character_hex_secret

WORKBOARD_MIGRATION_DATABASE_URL=postgresql+psycopg://workboard_migrator:replace_with_migrator_password@db:5432/workboard
WORKBOARD_RUNTIME_DATABASE_URL=postgresql+psycopg://workboard_app:replace_with_app_password@db:5432/workboard

WORKBOARD_JWT_SECRET=replace_with_a_64_character_hex_secret
